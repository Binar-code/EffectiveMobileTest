<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/course_card"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:strokeColor="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/course_image"
            android:layout_width="match_parent"
            android:layout_height="114dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_course_image"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/Course_TopRoundedImage" />

        <FrameLayout
            android:id="@+id/fav_container"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:layout_constraintEnd_toEndOf="@id/course_image"
            app:layout_constraintTop_toTopOf="@id/course_image"
            android:layout_margin="12dp">

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/fav_blur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_background_transparent_30"/>

            <ImageButton
                android:id="@+id/favorite_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_fav_card"
                android:contentDescription="@string/favorite" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/course_image"
            app:layout_constraintStart_toStartOf="@id/course_image"
            android:layout_margin="12dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <FrameLayout
                android:id="@+id/rate_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/rate_blur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/chip_background"/>

                <TextView
                    android:id="@+id/rating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_star"
                    android:drawablePadding="6dp"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/md_theme_dark_onBackground"
                    android:textSize="12sp"
                    tools:text="4.9" />
            </FrameLayout>

            <Space android:layout_width="4dp" android:layout_height="0dp"/>

            <FrameLayout
                android:id="@+id/date_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/date_blur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/chip_background"/>

                <TextView
                    android:id="@+id/date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/md_theme_dark_onBackground"
                    android:textSize="12sp"
                    tools:text="22 Мая 2024" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/course_image"
            app:layout_constraintVertical_bias="0.0">


            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_dark_onBackground"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Java-разработчик с нуля" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:breakStrategy="simple"
                android:lines="2"
                android:maxLines="2"
                android:textSize="16sp"
                tools:text="@string/placeholder_string" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="999 ₽"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_dark_onBackground"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/semibold_roboto"
                        android:includeFontPadding="false"
                        android:textColor="@color/md_theme_dark_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:text="Подробнее" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_arrow"
                        app:tint="@color/md_theme_dark_primary" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
